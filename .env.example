DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=America/Sao_Paulo

# SQLite (desenvolvimento)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_CONN_MAX_AGE=0

FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
LOG_LEVEL=INFO
LOG_FORMAT=standard
PUBLIC_DEMO_MODE=false
PDI_REQUIRE_LOGIN=false

# Obrigatórias quando PDI_REQUIRE_LOGIN=true
PDI_ADMIN_NAME=Kauan Bulgaroni
PDI_ADMIN_EMAIL=
PDI_ADMIN_PASSWORD=
SESSION_COOKIE_AGE=2592000

# Produção e monitoramento (opcionais no ambiente local)
DATABASE_URL=
DB_SSL_DISABLE=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
APP_ENVIRONMENT=development
